# Production template - อย่าใส่ credential จริงลง Git/ZIP
APP_NAME="ระบบสารสนเทศผู้รับบริการ"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH
APP_TIMEZONE=Asia/Bangkok

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ใช้ daily เพื่อลดความเสี่ยง laravel.log โตไม่จำกัด
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

# ตาราง sessions/cache มี migration อยู่ในโครงการแล้ว
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
# Shared hosting: ใช้ sync ก่อน ถ้ายังไม่ได้ตั้ง queue worker อย่างถูกต้อง
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_SERVE=false

# Forgot Password ต้องใช้ mail server จริงจึงจะส่งอีเมลได้
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="CHANGE_ME@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# PDF production hardening
DOMPDF_SHOW_WARNINGS=false
DOMPDF_ENABLE_REMOTE=false

VITE_APP_NAME="${APP_NAME}"
